# Copia este archivo a .env.local y rellena los valores del proyecto Supabase.
# No subas .env.local. No pongas la clave secreta en una variable NEXT_PUBLIC_.

# Project URL (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co

# Clave publicable del dashboard (o la anon key antigua, una de las dos).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_TU_CLAVE
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role / secret key. Solo servidor. Se salta RLS.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_TU_CLAVE

# URL pública de la tienda. La usa el enlace de seguimiento y el saludo de WhatsApp.
NEXT_PUBLIC_APP_URL=http://localhost:5000

# 32 bytes en base64. Solo servidor. Cifra el token de Meta. No la pongas en NEXT_PUBLIC_.
WHATSAPP_CLAVE=

# El mismo valor que configuras en el webhook de Meta. Solo servidor.
WA_VERIFY_TOKEN=
