{
  "name": "licorerias",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 5000",
    "build": "next build",
    "start": "next start -p 5000",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:ui": "node --experimental-strip-types --test src/components/ui/ui-sistema.test.ts",
    "test:licencias": "node --experimental-strip-types --test src/lib/licencias/reglas.test.ts && bash scripts/probar-licencias.sh",
    "test:sucursales": "node --experimental-strip-types --import ./scripts/cargar-alias.mjs --test src/lib/sucursales/reglas.test.ts && bash scripts/probar-sucursales.sh",
    "test:catalogo": "node --experimental-strip-types --import ./scripts/cargar-alias.mjs --test src/lib/catalogo/reglas.test.ts && bash scripts/probar-catalogo.sh",
    "test:inventario": "node --experimental-strip-types --import ./scripts/cargar-alias.mjs --test src/lib/inventario/reglas.test.ts && bash scripts/probar-inventario.sh",
    "test:ofertas": "node --experimental-strip-types --import ./scripts/cargar-alias.mjs --test src/lib/ofertas/reglas.test.ts && bash scripts/probar-ofertas.sh",
    "test:envio": "node --experimental-strip-types --import ./scripts/cargar-alias.mjs --test src/lib/envio/reglas.test.ts && bash scripts/probar-envio.sh",
    "test:pedidos": "node --experimental-strip-types --import ./scripts/cargar-alias.mjs --test src/lib/pedidos/reglas.test.ts && bash scripts/probar-pedidos.sh",
    "test:vitrina": "node --experimental-strip-types --import ./scripts/cargar-alias.mjs --test src/lib/tienda/reglas.test.ts && bash scripts/probar-vitrina.sh",
    "test:aislamiento": "bash scripts/probar-aislamiento.sh"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "leaflet": "^1.9.4",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
